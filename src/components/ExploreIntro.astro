---
// Shared "How to Explore" sidebar shown in the left info-box on the home page
// and on the genre detail pages (behind the info panel).
import CoffeeLink from './CoffeeLink.astro';

export interface Props {
  lang?: 'en' | 'es';
}

const { lang = Astro.currentLocale === 'es' ? 'es' : 'en' } = Astro.props;

const copy = lang === 'es'
  ? {
      title: 'Cómo explorar',
      intro: '¡Bienvenido a PulseRoots! Esta guía te ayuda a navegar por el vasto mundo de la música electrónica usando nuestras herramientas interactivas.',
      desktop: 'En <strong>escritorio</strong>, encontrarás un <strong>treemap</strong> inmersivo que mapea visualmente las conexiones entre géneros. En <strong>móvil</strong>, los géneros están organizados en una <strong>lista de acordeón</strong> clara y accesible.',
      stylesTitle: 'Estilos y subestilos',
      styles: 'Ambas vistas comienzan con amplias "Familias" (como Techno o House) y se ramifican en estilos y subestilos específicos. Haz clic o toca cualquier género para abrir un panel con una descripción detallada y una pista de ejemplo que te ayude a entender su sonido.',
      timelineTitle: 'Línea de tiempo musical',
      timeline: 'Haz clic en el botón <strong>Timeline</strong> para explorar <strong>107 hitos clave</strong> en la historia de la música electrónica, desde 1897 hasta hoy. Pasa el cursor sobre cualquier punto para leer la historia.',
      artistsTitle: 'Artistas clave',
      artists: 'Para cada género, incluimos una sección de "Artistas clave" con pioneros y músicos destacados que han moldeado su sonido.',
      a11yTitle: 'Accesibilidad',
      a11y: 'PulseRoots es accesible por teclado. Pulsa <strong>Tab</strong> para llegar al árbol de géneros, usa las <strong>flechas</strong> para moverte entre géneros y pulsa <strong>Enter</strong> o <strong>Espacio</strong> para abrir el panel de detalles del género seleccionado.',
      classificationTitle: 'Nota sobre la clasificación',
      classification: 'Esta visualización representa una interpretación de cómo se categorizan los géneros de música electrónica. La música es fluida y otras clasificaciones podrían agrupar los estilos de manera diferente según perspectivas culturales, históricas o sonoras.',
      inspirationsTitle: 'Inspiraciones',
      inspirations: 'PulseRoots está inspirado en el increíble trabajo de otros proyectos de exploración musical. Agradecimientos especiales a <a href="https://music.ishkur.com/" class="info-box-link" target="_blank" rel="noopener noreferrer">Ishkur\'s Guide to Electronic Music</a>, <a href="https://musicmap.info/" class="info-box-link" target="_blank" rel="noopener noreferrer">Musicmap</a> y <a href="https://everynoise.com/" class="info-box-link" target="_blank" rel="noopener noreferrer">Every Noise at Once</a> por abrir el camino.',
      listenTitle: 'Escuchar pistas',
      listen: 'Para escuchar las pistas de ejemplo, puede ser necesaria una cuenta de Spotify. El reproductor integrado ofrece una vista previa de 30 segundos para todos los usuarios. <a href="https://accounts.spotify.com/login" class="info-box-link" target="_blank" rel="noopener noreferrer">Iniciar sesión en Spotify</a> puede desbloquear la pista completa, según tu suscripción.',
      contactTitle: 'Contacto',
      thanks: 'Gracias por visitarnos, espero que disfrutes explorando el mundo de la música electrónica.',
      contact: 'Si tienes sugerencias, propuestas de mejora, has encontrado errores o solo quieres decir "¡Hola!", no dudes en escribirme a través de nuestra <a href="/pulse.roots/es/contact/" class="info-box-link">página de contacto</a>.',
    }
  : {
      title: 'How to Explore',
      intro: 'Welcome to PulseRoots! This guide helps you navigate the vast world of electronic music using our interactive tools.',
      desktop: 'On <strong>desktop</strong>, you\'ll find an immersive <strong>treemap</strong> that visually maps out the connections between genres. On <strong>mobile</strong>, the genres are organized into a clear and accessible <strong>accordion list</strong>.',
      stylesTitle: 'Styles and Substyles',
      styles: 'Both views start with broad "Families" (like Techno or House) and branch down into specific styles and substyles. Click or tap on any genre to open a panel with a detailed description and a sample track to help you understand its unique sound.',
      timelineTitle: 'Music History Timeline',
      timeline: 'Click the <strong>Timeline</strong> button to explore <strong>107 key milestones</strong> in electronic music history, from 1897 to the present day. Hover over any dot to read the story.',
      artistsTitle: 'Key Artists',
      artists: 'For each genre, we\'ve included a "Key Artists" section featuring pioneers and standout musicians who have significantly shaped its sound.',
      a11yTitle: 'Accessibility',
      a11y: 'PulseRoots is keyboard-accessible. Press <strong>Tab</strong> to reach the genre tree, then use the <strong>arrow keys</strong> to move between genres and press <strong>Enter</strong> or <strong>Space</strong> to open the details panel for the selected genre.',
      classificationTitle: 'Note on Classification',
      classification: 'This visualization represents one interpretation of how electronic music genres are categorized. Music is fluid, and other classifications might group styles differently based on cultural, historical, or sonic perspectives.',
      inspirationsTitle: 'Inspirations',
      inspirations: 'PulseRoots is inspired by the incredible work of other music exploration projects. Special thanks to <a href="https://music.ishkur.com/" class="info-box-link" target="_blank" rel="noopener noreferrer">Ishkur\'s Guide to Electronic Music</a>, <a href="https://musicmap.info/" class="info-box-link" target="_blank" rel="noopener noreferrer">Musicmap</a>, and <a href="https://everynoise.com/" class="info-box-link" target="_blank" rel="noopener noreferrer">Every Noise at Once</a> for paving the way.',
      listenTitle: 'Listening to Tracks',
      listen: 'To listen to the example tracks, a Spotify account may be required. The embedded player provides a 30-second preview for all users. <a href="https://accounts.spotify.com/login" class="info-box-link" target="_blank" rel="noopener noreferrer">Logging into Spotify</a> may unlock the full track, depending on your subscription.',
      contactTitle: 'Contact',
      thanks: 'Thank you for visiting, and I hope you enjoy exploring the world of electronic music.',
      contact: 'If you have any suggestions, improvement proposals, if you\'ve found any errors, or just want to say \'Hi!\', feel free to write to me through our <a href="/pulse.roots/contact/" class="info-box-link">contact page</a>.',
    };
---

<section>
  <h2 id="intro-title"><i class="bi bi-compass" aria-hidden="true"></i> {copy.title}</h2>
  <p>{copy.intro}</p>
  <p set:html={copy.desktop} />

  <h2><i class="bi bi-soundwave" aria-hidden="true"></i> {copy.stylesTitle}</h2>
  <p>{copy.styles}</p>

  <h2><i class="bi bi-clock-history" aria-hidden="true"></i> {copy.timelineTitle}</h2>
  <p set:html={copy.timeline} />

  <h2><i class="bi bi-person-check" aria-hidden="true"></i> {copy.artistsTitle}</h2>
  <p>{copy.artists}</p>

  <h2><i class="bi bi-keyboard" aria-hidden="true"></i> {copy.a11yTitle}</h2>
  <p set:html={copy.a11y} />

  <h2><i class="bi bi-journal-text" aria-hidden="true"></i> {copy.classificationTitle}</h2>
  <p>{copy.classification}</p>

  <h2 class="section-divider"><i class="bi bi-lightbulb" aria-hidden="true"></i> {copy.inspirationsTitle}</h2>
  <p set:html={copy.inspirations} />

  <h2 class="section-divider"><i class="bi bi-spotify" aria-hidden="true"></i> {copy.listenTitle}</h2>
  <p set:html={copy.listen} />

  <h2 class="section-divider"><i class="bi bi-envelope" aria-hidden="true"></i> {copy.contactTitle}</h2>
  <p>{copy.thanks}</p>
  <p set:html={copy.contact} />

  <p class="coffee-cta">
    <CoffeeLink lang={lang} />
  </p>
</section>
