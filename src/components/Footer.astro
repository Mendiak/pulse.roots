---
import fs from 'fs';
import path from 'path';
import { slugify } from '../utils/slug.js';
import CoffeeLink from './CoffeeLink.astro';

const dataDir = path.resolve(process.cwd(), 'public', 'data');
const basePath = '/pulse.roots';
const currentLang = Astro.currentLocale || 'en';
const langPrefix = currentLang === 'en' ? '' : `${currentLang}/`;
const now = new Date().getFullYear();

const t = currentLang === 'es'
  ? {
      logoAlt: 'Logotipo de PulseRoots',
      mission: 'Explora las conexiones profundas y la evolución de la música electrónica a través de una mirada interactiva. Un viaje de las raíces a los ritmos del futuro.',
      support: 'Apoyo',
      supportText: 'Un sitio gratuito hecho con pasión por la música electrónica. Cualquier muestra de apoyo ayuda a mantenerlo vivo.',
      portfolio: 'Portafolio',
      linksCredits: 'Enlaces y créditos',
      github: 'GitHub',
      logoCredit: 'Logotipo (Flaticon)',
      contact: 'Contacto',
      about: 'Sobre PulseRoots',
      privacy: 'Política de Privacidad',
      sitemap: 'Mapa del sitio',
      genres: 'Géneros',
      allGenres: 'Todos los géneros',
      copyright: 'Mapeando el pulso de la música electrónica.',
      linksNav: 'Enlaces y créditos',
      genresNav: 'Páginas de géneros',
    }
  : {
      logoAlt: 'PulseRoots Logo',
      mission: 'Explore the deep connections and evolution of electronic music through an interactive lens. A journey from roots to future rhythms.',
      support: 'Support',
      supportText: 'A free website built with passion for electronic music. Any token of support helps keep it alive.',
      portfolio: 'Portfolio',
      linksCredits: 'Links & Credits',
      github: 'Github',
      logoCredit: 'Logo (Flaticon)',
      contact: 'Contact',
      about: 'About',
      privacy: 'Privacy Policy',
      sitemap: 'Sitemap',
      genres: 'Genres',
      allGenres: 'All genres',
      copyright: 'Mapping the pulse of electronic music.',
      linksNav: 'Links and Credits',
      genresNav: 'Genre Pages',
    };

function escapeHtml(text) {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Load genre data
const isDefaultLang = currentLang === 'en';
const fileName = isDefaultLang ? 'pulseroots.genres.json' : `pulseroots.genres.${currentLang}.json`;
let genreHtml = '';

try {
  const filePath = path.join(dataDir, fileName);
  const fileExists = fs.existsSync(filePath);
  const sourcePath = fileExists ? filePath : path.join(dataDir, 'pulseroots.genres.json');

  if (fs.existsSync(sourcePath)) {
    const data = JSON.parse(fs.readFileSync(sourcePath, 'utf-8'));

    // Build flat list of all genres with full paths
    const allGenres = [];
    const traverse = (items, slugParts) => {
      for (const item of items) {
        const name = item.name || item.style;
        if (!name) continue;
        const slug = slugify(name);
        const fullPath = [...slugParts, slug].join('/');
        allGenres.push({ genreName: name, fullSlugPath: fullPath });

        if (item.substyles && item.substyles.length > 0) {
          traverse(item.substyles, [...slugParts, slug]);
        }
      }
    };
    traverse(data, []);

    // Build hierarchical tree HTML
    const childrenMap = {};
    for (const info of allGenres) {
      const parts = info.fullSlugPath.split('/');
      const parentKey = parts.slice(0, -1).join('/');
      if (!childrenMap[parentKey]) childrenMap[parentKey] = [];
      childrenMap[parentKey].push(info);
    }

    for (const key of Object.keys(childrenMap)) {
      childrenMap[key].sort((a, b) => a.genreName.localeCompare(b.genreName));
    }

    // Genre pages exist in both locales, so the footer follows the current one.
    const genreBase = `${basePath}/${langPrefix}genres`;

    const topLevel = (childrenMap[''] || []).sort((a, b) => a.genreName.localeCompare(b.genreName));
    genreHtml += '<ul class="footer-genre-families">\n';
    for (const top of topLevel) {
      genreHtml += `  <li><a href="${genreBase}/${top.fullSlugPath}/">${escapeHtml(top.genreName)}</a></li>\n`;
    }
    genreHtml += '</ul>\n';
    genreHtml += `<a class="footer-all-genres" href="${basePath}/${langPrefix}genres/">${t.allGenres} &rarr;</a>\n`;
  }
} catch (e) {
  console.error('Error loading genre tree:', e);
}
---

<footer>
  <div id="footer-main">
    <div id="footer-brand">
      <img src={`/pulse.roots/assets/footer-logo.png`} id="footer-logo" alt={t.logoAlt} width="128" height="128" loading="lazy">
      <p id="footer-mission">{t.mission}</p>
    </div>

    <div id="footer-support">
      <h3>{t.support}</h3>
      <p id="footer-support-text">{t.supportText}</p>
      <div id="footer-support-links">
        <a class="footer-link" href="https://mendiak.github.io/portfolio/" target="_blank" rel="noopener noreferrer">
          <i class="bi bi-code-slash"></i> <span>{t.portfolio}</span>
        </a>
        <CoffeeLink variant="pill" lang={currentLang} />
      </div>
    </div>

    <nav id="footer-links" aria-label={t.linksNav}>
      <h3>{t.linksCredits}</h3>
      <ul>
        <li><a class="footer-link" href="https://github.com/Mendiak/pulse.roots" target="_blank" rel="noopener noreferrer"><i class="bi bi-github"></i> <span>{t.github}</span></a></li>
        <li><a class="footer-link" href="https://www.flaticon.com/" target="_blank" rel="noopener noreferrer"><i class="bi bi-vector-pen"></i> <span>{t.logoCredit}</span></a></li>
        <li><a class="footer-link" href={`${basePath}/${langPrefix}contact/`}><i class="bi bi-patch-question"></i> <span>{t.contact}</span></a></li>
        <li><a class="footer-link" href={`${basePath}/${langPrefix}about/`}><i class="bi bi-info-circle"></i> <span>{t.about}</span></a></li>
        <li><a class="footer-link" href={`${basePath}/${langPrefix}privacy/`}><i class="bi bi-shield-lock"></i> <span>{t.privacy}</span></a></li>
        <li><a class="footer-link" href={`${basePath}/${langPrefix}sitemap/`}><i class="bi bi-diagram-3"></i> <span>{t.sitemap}</span></a></li>
      </ul>
    </nav>

    <nav id="footer-genres" aria-label={t.genresNav}>
      <h3>{t.genres}</h3>
      <div set:html={genreHtml} />
    </nav>
  </div>

  <div id="footer-stats">
    <div id="footer-stats-content"></div>
  </div>

  <div id="footer-bottom">
    <p>&copy; {now} PulseRoots. {t.copyright}</p>
  </div>
</footer>
