---
export interface Props {
  simple?: boolean;
  /**
   * Tag used for the site name. Pages that carry their own <h1> pass "div"
   * so the document keeps a single, page-specific heading.
   */
  brandAs?: 'h1' | 'div';
}

const basePath = '/pulse.roots';
const currentLang = Astro.currentLocale || 'en';
const { simple = false, brandAs = 'h1' } = Astro.props;
const BrandTag = brandAs;

// Campaign tagging so shared visits are attributable in GA4.
const siteUrl = 'https://mendiak.github.io/pulse.roots/';
const shareLink = source =>
  encodeURIComponent(`${siteUrl}?utm_source=${source}&utm_medium=social&utm_campaign=share`);
---

<header>
  <a href="#main-container" class="skip-link">Skip to content</a>
  <div id="header-container">
    <a href={`${basePath}/${currentLang === 'en' ? '' : currentLang}`} id="logo-link" aria-label="PulseRoots: Electronic Music Styles Tree - Home">
      <img src={`${basePath}/assets/logo.png`} id="logo" alt="PulseRoots Logo" width="64" height="64">
      <BrandTag class="site-title">PulseRoots: Electronic Music Styles Tree</BrandTag>
    </a>
    <div class="header-controls">
      {!simple && (
        <>
          <div id="search-container" class="header-group">
            <input type="text" id="search-input" placeholder="Search for a genre..." aria-label="Search for a genre" title="Press / to search" autocomplete="off"
              data-i18n-placeholder="header.searchPlaceholder" data-i18n-aria-label="header.searchLabel" data-i18n-title="search.shortcutTitle"
              role="combobox" aria-expanded="false" aria-controls="search-suggestions" aria-autocomplete="list">
            <div id="search-suggestions" class="hidden" role="listbox"></div>
            <div id="search-nav" class="hidden">
              <span id="search-counter" role="status" aria-live="polite">0 of 0</span>
              <div class="search-nav-btns">
                <button id="search-prev" title="Previous result" data-i18n-title="search.searchNav.prevTitle"><i class="bi bi-chevron-up"></i></button>
                <button id="search-next" title="Next result" data-i18n-title="search.searchNav.nextTitle"><i class="bi bi-chevron-down"></i></button>
              </div>
            </div>
            <button id="clear-button" class="hidden" aria-label="Clear search" data-i18n-aria-label="header.clearSearchLabel"><i class="bi bi-x-lg" aria-hidden="true"></i> <span data-i18n="header.clearButton">Clear</span></button>
            <button id="shuffle-button" title="Random Genre" data-i18n-title="header.shuffleTitle"><i class="bi bi-shuffle"></i></button>
          </div>
          <div id="layout-controls" class="header-group">
            <button id="tree-layout-btn" class="layout-btn active" title="Tree Layout" data-i18n-title="header.treeLayoutTitle"><i class="bi bi-diagram-3-fill"></i></button>
            <button id="radial-layout-btn" class="layout-btn" title="Radial Layout" data-i18n-title="header.radialLayoutTitle"><i class="bi bi-bullseye"></i></button>
            <button id="timeline-layout-btn" class="layout-btn" title="Timeline" data-i18n-title="header.timelineTitle"><i class="bi bi-clock-history"></i></button>
          </div>
        </>
      )}
      <div id="lang-selector" class="header-group">
        <a data-lang="en" href="/pulse.roots/" class:list={['lang-btn', { active: currentLang === 'en' }]}>EN</a>
        <a data-lang="es" href="/pulse.roots/es/" class:list={['lang-btn', { active: currentLang === 'es' }]}>ES</a>
      </div>
      <div class="header-group header-actions">
        {!simple && (
          <>
            <button id="fullscreen-btn" title="Toggle Fullscreen" aria-label="Enter Fullscreen" data-i18n-title="header.fullscreenTitle" data-i18n-aria-label="header.fullscreenLabel">
              <i class="bi bi-fullscreen"></i>
            </button>
            <div class="share-btn-wrapper">
              <button id="header-share-btn" title="Share PulseRoots" aria-label="Share PulseRoots" data-i18n-title="header.shareTitle" data-i18n-aria-label="header.shareLabel">
                <i class="bi bi-share"></i>
              </button>
              <div id="share-popover" role="dialog" aria-label="Share options">
                <div class="share-popover-arrow"></div>
                <div class="share-popover-content">
                  <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareLink('facebook')}`}
                    target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class="share-popover-btn">
                    <i class="bi bi-facebook"></i> <span>Facebook</span>
                  </a>
                  <a href={`https://x.com/intent/tweet?url=${shareLink('x')}&text=Explore%20the%20evolution%20of%20electronic%20music%20with%20PulseRoots!%20%23ElectronicMusic%20%23MusicGenres`}
                    target="_blank" rel="noopener noreferrer" aria-label="Share on X (Twitter)" class="share-popover-btn">
                    <i class="bi bi-twitter-x"></i> <span>X</span>
                  </a>
                  <a href={`https://www.reddit.com/submit?url=${shareLink('reddit')}&title=PulseRoots:%20Electronic%20Music%20Styles%20Tree`}
                    target="_blank" rel="noopener noreferrer" aria-label="Share on Reddit" class="share-popover-btn">
                    <i class="bi bi-reddit"></i> <span>Reddit</span>
                  </a>
                  <button id="share-popover-copy" aria-label="Copy link" class="share-popover-btn">
                    <i class="bi bi-clipboard"></i> <span>Copy Link</span>
                  </button>
                </div>
              </div>
            </div>
          </>
        )}
        <button id="theme-toggle-btn" title="Toggle Theme" aria-label="Toggle Light/Dark Mode" data-i18n-title="header.themeTitle" data-i18n-aria-label="header.themeLabel">
          <i class="bi bi-moon"></i>
        </button>
        <a href={`${basePath}/${currentLang === 'en' ? '' : currentLang + '/'}contact/`} id="header-contact-btn"
          title="Suggest a Genre / Fix an Error" aria-label="Suggest a Genre / Fix an Error" data-i18n-title="header.contactTitle" data-i18n-aria-label="header.contactLabel">
          <i class="bi bi-patch-question"></i>
        </a>
      </div>
    </div>
  </div>
</header>
