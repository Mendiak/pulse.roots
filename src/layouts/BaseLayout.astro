---
import fs from 'fs';
import path from 'path';
import '../styles/fonts.css';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/layout.css';
import '../styles/typography.css';
import '../styles/visualization.css';
import '../styles/controls.css';
import '../styles/panel.css';
import '../styles/forms.css';
import '../styles/footer.css';
import '../styles/tooltips.css';
import '../styles/mobile-nav.css';
import '../styles/responsive.css';
import '../styles/components.css';
import CookieConsent from '../islands/CookieConsent.astro';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  lang?: string;
  jsonLd?: string;
  noindex?: boolean;
  /** Pages that are not part of the indexed site (e.g. 404) omit the canonical. */
  hideCanonical?: boolean;
}

const baseUrl = 'https://mendiak.github.io/pulse.roots';
const currentLang = Astro.currentLocale || 'en';

const i18nPath = path.resolve(process.cwd(), 'public', 'data', 'i18n', `${currentLang}.json`);
let i18n = {};
try {
  i18n = JSON.parse(fs.readFileSync(i18nPath, 'utf-8'));
} catch {
  const enPath = path.resolve(process.cwd(), 'public', 'data', 'i18n', 'en.json');
  i18n = JSON.parse(fs.readFileSync(enPath, 'utf-8'));
}
const seo = i18n.seo || {};

const {
  title = seo.title || 'PulseRoots: Electronic Music Styles Tree',
  description = seo.description || 'Explore the evolution of electronic music with PulseRoots. An interactive tree visualization mapping genres from Techno and House to Ambient and Experimental. Discover styles, substyles, and sample tracks.',
  ogTitle = seo.ogTitle || title,
  ogDescription = seo.ogDescription || description,
  ogImage = `${baseUrl}/assets/og_image.jpg`,
  ogImageAlt = 'PulseRoots - interactive electronic music genre tree',
  canonical = baseUrl + '/',
  lang = currentLang,
  jsonLd = '',
  noindex = false,
  hideCanonical = false,
} = Astro.props;

const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogImageType = ogImage.endsWith('.webp')
  ? 'image/webp'
  : ogImage.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';

// hreflang: derive the language-neutral path from the canonical URL so a page
// that already lives under /es/ is not prefixed twice.
const basePathname = canonical.startsWith(baseUrl) ? canonical.slice(baseUrl.length) || '/' : '/';
const enPathname = basePathname.replace(/^\/es(?=\/|$)/, '') || '/';
const enHref = `${baseUrl}${enPathname}`;
const esHref = `${baseUrl}/es${enPathname === '/' ? '/' : enPathname}`;

// Genre pages only exist in the default locale.
const isGenrePage = canonical.includes('/genres/');
const hasSpanish = !isGenrePage;

// Site-wide entities emitted on every page so page-level graphs can reference
// them by @id without redefining them.
const siteGraph = [
  {
    '@type': 'WebSite',
    '@id': `${baseUrl}/#website`,
    name: 'PulseRoots',
    url: `${baseUrl}/`,
    description:
      seo.jsonldDescription ||
      'Explore the evolution of electronic music with PulseRoots: an interactive tree mapping genres from Techno and House to Ambient and Experimental.',
    inLanguage: ['en', 'es'],
    publisher: { '@id': `${baseUrl}/#person` },
  },
  {
    '@type': 'Person',
    '@id': `${baseUrl}/#person`,
    name: 'Mikel Aramendia',
    url: 'https://mendiak.github.io/portfolio/',
    sameAs: ['https://github.com/Mendiak', 'https://www.buymeacoffee.com/Mendiak'],
    knowsAbout: ['Electronic music', 'Music genres', 'Music history'],
    worksFor: { '@id': `${baseUrl}/#website` },
  },
];

// Merge page-level JSON-LD with the site graph, dropping duplicate nodes that
// already exist globally (same @id).
let pageGraph = [];
if (jsonLd) {
  try {
    const parsed = JSON.parse(jsonLd);
    pageGraph = parsed['@graph'] || [parsed];
  } catch {
    pageGraph = [];
  }
}
const globalIds = new Set(siteGraph.map(node => node['@id']));
pageGraph = pageGraph.filter(node => !node['@id'] || !globalIds.has(node['@id']));

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [...siteGraph, ...pageGraph],
});
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>

  {!hideCanonical && <link rel="canonical" href={canonical}>}
  <meta name="description" content={description}>
  <meta name="author" content="PulseRoots">
  <meta
    name="robots"
    content={noindex
      ? 'noindex, follow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
  >
  <meta name="theme-color" content="#080808">

  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content={ogImageType}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content={ogLocale}>
  {hasSpanish && <meta property="og:locale:alternate" content={ogLocale === 'es_ES' ? 'en_US' : 'es_ES'}>}
  <meta property="og:site_name" content="PulseRoots">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <meta name="google-site-verification" content="7tAbK2WB9Cx4uF76izgXcrBdBXVeqDfUd9A97KrLewU" />

  <link rel="icon" href="/pulse.roots/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" sizes="180x180" href="/pulse.roots/assets/apple-touch-icon.png">
  <link rel="manifest" href="/pulse.roots/site.webmanifest">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/pulse.roots/sitemap-index.xml">

  <link rel="preload" as="font" type="font/woff2" href="/pulse.roots/assets/fonts/cb308db001b5.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/pulse.roots/assets/fonts/d8a316f7cbfa.woff2" crossorigin>

  <link rel="stylesheet" href="/pulse.roots/assets/icons/bootstrap-icons.css" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="/pulse.roots/assets/icons/bootstrap-icons.css">
  </noscript>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function() { dataLayer.push(arguments); };
  </script>

  <script type="application/ld+json" set:html={structuredData}></script>

  <link rel="alternate" hreflang="en" href={enHref}>
  {hasSpanish && <link rel="alternate" hreflang="es" href={esHref}>}
  <link rel="alternate" hreflang="x-default" href={enHref}>
</head>
<body>
  <script is:inline>
    (function() {
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.body.classList.add('light-mode');
        }
      } catch(e) {}
    })();
  </script>

  <CookieConsent />

  <div id="cookie-consent-banner">
    <div class="cookie-content">
      <div class="cookie-text">
        {lang === 'es' ? (
          <p>Usamos cookies para mejorar tu experiencia. Al continuar, aceptas nuestra <a href="/pulse.roots/privacy/">Política de Privacidad</a>.</p>
        ) : (
          <p>We use cookies to improve your experience. By continuing, you agree to our <a href="/pulse.roots/privacy/">Privacy Policy</a>.</p>
        )}
      </div>
      <div class="cookie-buttons">
        <button id="cookie-accept-btn" class="cookie-btn cookie-btn-accept">{lang === 'es' ? 'Aceptar' : 'Accept'}</button>
        <button id="cookie-reject-btn" class="cookie-btn cookie-btn-reject">{lang === 'es' ? 'Rechazar' : 'Reject'}</button>
      </div>
    </div>
  </div>

  <slot />

  <script>
    (function() {
      const btn = document.getElementById('theme-toggle-btn');
      if (!btn) return;
      const icon = btn.querySelector('i');
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        icon.classList.replace('bi-moon', 'bi-sun');
        btn.setAttribute('aria-label', 'Switch to Dark Mode');
      }
    })();
  </script>
</body>
</html>
