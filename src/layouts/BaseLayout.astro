---
import fs from 'fs';
import path from 'path';
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/header.css';
import '../styles/layout.css';
import '../styles/typography.css';
import '../styles/visualization.css';
import '../styles/controls.css';
import '../styles/panel.css';
import '../styles/forms.css';
import '../styles/footer.css';
import '../styles/tooltips.css';
import '../styles/mobile-nav.css';
import '../styles/responsive.css';
import '../styles/components.css';
import CookieConsent from '../islands/CookieConsent.astro';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonical?: string;
  lang?: string;
  jsonLd?: string;
  noindex?: boolean;
}

const baseUrl = 'https://mendiak.github.io/pulse.roots';
const currentLang = Astro.currentLocale || 'en';

const i18nPath = path.resolve(process.cwd(), 'public', 'data', 'i18n', `${currentLang}.json`);
let i18n = {};
try {
  i18n = JSON.parse(fs.readFileSync(i18nPath, 'utf-8'));
} catch {
  const enPath = path.resolve(process.cwd(), 'public', 'data', 'i18n', 'en.json');
  i18n = JSON.parse(fs.readFileSync(enPath, 'utf-8'));
}
const seo = i18n.seo || {};

const {
  title = seo.title || 'PulseRoots: Electronic Music Styles Tree',
  description = seo.description || 'Explore the evolution of electronic music with PulseRoots. An interactive tree visualization mapping genres from Techno and House to Ambient and Experimental. Discover styles, substyles, and sample tracks.',
  ogTitle = seo.ogTitle || title,
  ogDescription = seo.ogDescription || description,
  ogImage = `${baseUrl}/assets/og_image.webp`,
  canonical = baseUrl + '/',
  lang = currentLang,
  jsonLd = '',
  noindex = false,
} = Astro.props;

const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';

// Dynamic hreflang computation
const isGenrePage = canonical.includes('/genres/');
const enHref = canonical.replace(`/es/`, '/');
const esHref = canonical.replace(baseUrl, `${baseUrl}/es`);
const hasSpanish = !isGenrePage;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>

  <link rel="canonical" href={canonical}>
  <meta name="description" content={description}>
  <meta name="author" content="PulseRoots">
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
  <meta name="theme-color" content="#080808">

  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content={ogLocale}>
  <meta property="og:site_name" content="PulseRoots">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>

  <meta name="google-site-verification" content="7tAbK2WB9Cx4uF76izgXcrBdBXVeqDfUd9A97KrLewU" />

  <link rel="icon" href="/pulse.roots/assets/favicon.png" type="image/x-icon">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/pulse.roots/sitemap-index.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,100..900;1,100..900&family=Outfit:wght@100..900&display=swap"
    rel="stylesheet" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,100..900;1,100..900&family=Outfit:wght@100..900&display=swap">
  </noscript>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  </noscript>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function() { dataLayer.push(arguments); };
  </script>

  {jsonLd && <script type="application/ld+json" set:html={jsonLd}></script>}

  <link rel="alternate" hreflang="en" href={enHref}>
  {hasSpanish && <link rel="alternate" hreflang="es" href={esHref}>}
  <link rel="alternate" hreflang="x-default" href={enHref}>
</head>
<body>
  <script is:inline>
    (function() {
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.body.classList.add('light-mode');
        }
      } catch(e) {}
    })();
  </script>

  <CookieConsent />

  <div id="cookie-consent-banner">
    <div class="cookie-content">
      <div class="cookie-text">
        {lang === 'es' ? (
          <p>Usamos cookies para mejorar tu experiencia. Al continuar, aceptas nuestra <a href="/pulse.roots/privacy/">Política de Privacidad</a>.</p>
        ) : (
          <p>We use cookies to improve your experience. By continuing, you agree to our <a href="/pulse.roots/privacy/">Privacy Policy</a>.</p>
        )}
      </div>
      <div class="cookie-buttons">
        <button id="cookie-accept-btn" class="cookie-btn cookie-btn-accept">{lang === 'es' ? 'Aceptar' : 'Accept'}</button>
        <button id="cookie-reject-btn" class="cookie-btn cookie-btn-reject">{lang === 'es' ? 'Rechazar' : 'Reject'}</button>
      </div>
    </div>
  </div>

  <slot />

  <script>
    (function() {
      const btn = document.getElementById('theme-toggle-btn');
      if (!btn) return;
      const icon = btn.querySelector('i');
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        icon.classList.replace('bi-moon', 'bi-sun');
        btn.setAttribute('aria-label', 'Switch to Dark Mode');
      }
    })();
  </script>
</body>
</html>
