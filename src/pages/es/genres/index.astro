---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { loadGenres, flattenGenres, slugify } from '../../../utils/genres-data.js';

const SITE = 'https://mendiak.github.io/pulse.roots';
const canonical = `${SITE}/es/genres/`;

const families = loadGenres('es')
  .map(family => {
    const name = family.style || family.name;
    if (!name) return null;
    const styles = flattenGenres(family.substyles || [], 'es');
    const description = (family.description || '').trim();
    return {
      name,
      slug: slugify(name),
      count: styles.length + 1,
      description: description.length > 180
        ? `${description.slice(0, 177).replace(/\s+\S*$/, '')}...`
        : description,
    };
  })
  .filter(Boolean)
  .sort((a, b) => a.name.localeCompare(b.name));

const totalStyles = families.reduce((sum, family) => sum + family.count, 0);

// El mismo texto alimenta el FAQ visible y el schema FAQPage.
const faq = [
  {
    q: '¿Cuántos tipos de música electrónica hay?',
    a: `No hay una cifra oficial. PulseRoots reúne ${totalStyles} estilos y subestilos en ${families.length} familias, desde la música experimental y de cinta hasta el hyperpop, el phonk y el amapiano. Cada año aparecen escenas nuevas, así que el árbol se revisa y amplía.`,
  },
  {
    q: '¿Cuáles son los géneros principales de la música electrónica?',
    a: 'Techno, House, Trance, Ambient, Bass Music, Breakbeat, Electro, Disco, Chill Out, Experimental, Industrial, Pop and Rock Fusion, Funk and Soul Fusion y Global Club. Cada página de familia enumera sus estilos y subestilos con descripción, artistas clave y una pista de ejemplo.',
  },
  {
    q: '¿Qué diferencia hay entre un género y un subgénero?',
    a: 'Un género es una familia amplia definida por una escena, un sonido y una época. Un subgénero es una rama que mantiene los rasgos centrales de su padre pero cambia el tempo, la textura o el público. El Detroit Techno es un estilo dentro del Techno, y el Ghettotech es un subgénero del Detroit Techno.',
  },
  {
    q: '¿Cómo se usa este árbol de géneros?',
    a: 'Empieza por una de las familias de abajo y sigue las ramas hacia estilos y subestilos. Cada página de género enlaza con su estilo padre, con sus subestilos y con estilos relacionados, así que puedes moverte entre familias amplias y microgéneros en ambos sentidos.',
  },
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "url": canonical,
      "name": "Géneros de música electrónica: el árbol completo",
      "description": "Todas las familias de música electrónica de PulseRoots, del Techno y el House al Ambient, el Experimental y el Global Club.",
      "isPartOf": { "@id": `${SITE}/#website` },
      "inLanguage": "es",
      "image": `${SITE}/assets/maps/overview-es.jpg`,
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": families.length,
        "itemListElement": families.map((family, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": family.name,
          "url": `${SITE}/es/genres/${family.slug}/`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${SITE}/es/` },
        { "@type": "ListItem", "position": 2, "name": "Géneros", "item": canonical },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Tipos de música electrónica: lista y árbol completo | PulseRoots"
  description={`Lista completa de tipos y géneros de música electrónica por familias: Techno, House, Trance, Ambient, Bass, Breakbeat, Experimental y más. ${totalStyles}+ estilos.`}
  canonical={canonical}
  lang="es"
  jsonLd={jsonLd}
  ogImage={`${SITE}/assets/maps/overview-es.jpg`}
  ogImageAlt={`El árbol de géneros de música electrónica de PulseRoots: ${families.length} familias y ${totalStyles} estilos`}
  esAvailable
>
  <Header brandAs="div" />
  <main>
    <article id="genres-hub" class="container">
      <h1>Tipos de música electrónica: lista y árbol completo</h1>
      <p class="genres-lead">
        PulseRoots agrupa más de {totalStyles} estilos de música electrónica en {families.length} familias.
        Empieza por una familia para ver cómo evolucionaron sus estilos y subestilos, o consulta la
        <a href="/pulse.roots/es/sitemap/">lista alfabética de todos los géneros</a>.
      </p>

      <figure class="genres-map">
        <img
          src="/pulse.roots/assets/maps/overview-es.jpg"
          alt={`Mapa de las ${families.length} familias de música electrónica y los ${totalStyles} estilos que salen de ellas`}
          width="1200"
          height="630"
          fetchpriority="high"
          decoding="async"
        >
        <figcaption>
          {families.length} familias, {totalStyles} estilos. Cada rama abre una página con sus
          subestilos, artistas clave y una pista de ejemplo.
        </figcaption>
      </figure>

      <ul class="genres-stats">
        <li><strong>{families.length}</strong><span>familias</span></li>
        <li><strong>{totalStyles}+</strong><span>estilos y subestilos</span></li>
        <li><strong>1</strong><span>pista de ejemplo por género</span></li>
      </ul>

      <ul class="genres-family-grid">
        {families.map(family => (
          <li>
            <a href={`/pulse.roots/es/genres/${family.slug}/`}>
              <h2>{family.name}</h2>
              <p class="genres-family-count">{family.count} estilos</p>
              {family.description && <p class="genres-family-desc">{family.description}</p>}
            </a>
          </li>
        ))}
      </ul>

      <section aria-labelledby="genres-about">
        <h2 id="genres-about">Cómo está organizado este árbol de géneros</h2>
        <p>
          Cada familia es un punto de partida: Techno, House, Trance, Ambient, Bass Music, Breakbeat,
          Electro, Disco, Chill Out, Experimental, Industrial, Pop and Rock Fusion, Funk and Soul Fusion
          y Global Club. Las familias se ramifican en estilos y subestilos, así que una página como
          Detroit Techno cuelga de Techno, y Ghettotech cuelga de Detroit Techno.
        </p>
        <p>
          La jerarquía es una interpretación, no una regla. Los géneros se solapan, se dividen y se
          fusionan, y el mismo sonido puede clasificarse de otra forma en otro lugar. Cada página de
          género enlaza con su estilo padre, sus subestilos y sus vecinos más cercanos, para que puedas
          recorrer el árbol en cualquier dirección.
        </p>
        <p>
          ¿Buscas algo concreto? Usa el buscador de la cabecera o consulta el
          <a href="/pulse.roots/es/sitemap/">mapa del sitio</a>.
          Si quieres la historia que hay detrás de estas ramas, lee
          <a href="/pulse.roots/es/guides/electronic-music-history/">cómo llegó hasta aquí la música electrónica</a>.
        </p>
      </section>

      <section class="genres-faq" aria-labelledby="genres-faq-title">
        <h2 id="genres-faq-title">Preguntas frecuentes</h2>
        {faq.map(item => (
          <div class="genres-faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </section>
    </article>
  </main>
  <Footer />

  <style>
    #genres-hub { max-width: 1000px; margin: 40px auto; padding: 40px; color: var(--text-main); }
    #genres-hub h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 16px; }
    #genres-hub h2 { font-size: 1.15rem; font-weight: 700; margin: 0 0 4px; }
    .genres-lead { color: var(--text-muted); margin-bottom: 28px; }
    .genres-lead a, #genres-hub section a { color: var(--accent-pink); text-decoration: none; border-bottom: 1px solid rgba(255, 0, 102, 0.35); }
    .genres-stats { list-style: none; margin: 0 0 32px; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
    .genres-stats li { flex: 1 1 160px; padding: 14px 16px; border: 1px solid var(--glass-border); border-radius: 12px; background: rgba(255, 255, 255, 0.02); }
    .genres-stats strong { display: block; font-size: 1.6rem; font-weight: 800; color: var(--accent-pink); line-height: 1.1; }
    .genres-stats span { display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 2px; }
.genres-map { margin: 0 0 32px; }
.genres-map img { display: block; width: 100%; height: auto; border-radius: var(--radius-xl); border: 1px solid var(--glass-border); }
.genres-map figcaption { margin-top: 10px; font-size: 0.85rem; color: var(--text-muted); }
    .genres-family-grid { list-style: none; margin: 0 0 40px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
    .genres-family-grid li a { display: block; height: 100%; padding: 16px 18px; border: 1px solid var(--glass-border); border-radius: 12px; text-decoration: none; color: inherit; background: rgba(255, 255, 255, 0.02); transition: border-color 0.2s ease, transform 0.2s ease; }
    .genres-family-grid li a:hover { border-color: var(--accent-pink); transform: translateY(-2px); }
    .genres-family-count { color: var(--accent-pink); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 8px; }
    .genres-family-desc { color: var(--text-muted); font-size: 0.9rem; margin: 0; line-height: 1.5; }
    #genres-hub section p { color: var(--text-muted); line-height: 1.7; }
    .genres-faq { margin-top: 12px; }
    .genres-faq h3 { font-size: 1rem; font-weight: 700; margin: 0 0 4px; color: var(--text-main); }
    .genres-faq-item { padding: 14px 0; border-top: 1px solid var(--glass-border); }
    .genres-faq-item p { margin: 0; }
    @media (max-width: 768px) { #genres-hub { margin: 20px; padding: 20px; } }
  </style>
</BaseLayout>
