---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GenreFamilies from '../../components/GenreFamilies.astro';
import SiteExplainer from '../../components/SiteExplainer.astro';
import ExploreIntro from '../../components/ExploreIntro.astro';
import { siteFaq } from '../../data/site-faq.js';

const canonical = 'https://mendiak.github.io/pulse.roots/es/';
const SITE = 'https://mendiak.github.io/pulse.roots';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${SITE}/es/#webpage`,
      "url": canonical,
      "name": "Mapa de géneros de música electrónica | PulseRoots",
      "isPartOf": { "@id": `${SITE}/#website` },
      "inLanguage": "es",
      "about": { "@id": `${SITE}/#website` }
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE}/es/#faq`,
      "inLanguage": "es",
      "mainEntity": siteFaq.es.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    }
  ]
});
---

<BaseLayout lang="es" canonical={canonical} jsonLd={jsonLd}>
  <div id="scroll-progress-container">
    <div id="scroll-progress-bar"></div>
  </div>

  <Header />

  <div id="history-banner">
    <p><strong>Historia de la música:</strong> <span id="history-fact"></span></p>
  </div>

  <main>
    <div id="main-container">
      <div id="tooltip" class="info-box" aria-labelledby="intro-title">
        <ExploreIntro lang="es" />
      </div>

      <div id="visualization-container">
        <div id="loading-spinner" class="hidden">
          <div class="spinner"></div>
          <p>Cargando géneros...</p>
        </div>
        <svg id="treemap"></svg>
      </div>

      <div id="mobile-nav-container">
        <h2 data-i18n="mobileNav.title">Explorar Géneros</h2>
        <div id="mobile-search-container">
          <input type="text" id="mobile-search-input" placeholder="Filtrar géneros..." autocomplete="off" aria-label="Filtrar géneros" data-i18n-placeholder="search.mobilePlaceholder" data-i18n-aria-label="search.mobileLabel">
          <button id="mobile-clear-button" class="hidden"><i class="bi bi-x-lg"></i></button>
        </div>
        <div id="accordion-controls">
          <button id="expand-all-btn" data-i18n="mobileNav.expandAll">Expandir todo</button>
          <button id="collapse-all-btn" data-i18n="mobileNav.collapseAll">Contraer todo</button>
        </div>
        <ul id="mobile-genre-list"></ul>
      </div>
    </div>

    <GenreFamilies lang="es" />

    <SiteExplainer lang="es" />

    <button id="back-to-top-btn" aria-label="Volver arriba">
      <i class="bi bi-arrow-up"></i>
    </button>
  </main>

  <div id="modal-overlay"></div>

  <div id="info-panel" role="dialog" aria-modal="true" aria-label="Información del género" aria-labelledby="info-panel-title">
    <div id="info-content"></div>
    <div id="scroll-indicator" class="hidden">
      <i class="bi bi-arrow-down-circle"></i>
    </div>
  </div>



  <Footer />

  <script is:inline>
    window.PR_LANG = 'es';
    window.PR_I18N = {};
    window.PR_I18N_FALLBACK = {};
  </script>

  <script>
    import '../../js/main.js';
  </script>
</BaseLayout>
