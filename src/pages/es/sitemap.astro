---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadGenres, flattenGenres, slugify } from '../../utils/genres-data.js';

const SITE = 'https://mendiak.github.io/pulse.roots';
const canonical = `${SITE}/es/sitemap/`;

const families = loadGenres('es')
  .map(family => {
    const name = family.style || family.name;
    if (!name) return null;
    const familySlug = slugify(name);
    return {
      name,
      slug: familySlug,
      styles: flattenGenres(family.substyles || [], 'es').map(style => ({
        ...style,
        fullSlugPath: `${familySlug}/${style.fullSlugPath}`,
      })),
    };
  })
  .filter(Boolean)
  .sort((a, b) => a.name.localeCompare(b.name));

const totalStyles = families.reduce((sum, family) => sum + family.styles.length + 1, 0);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "url": canonical,
      "name": "Mapa del Sitio - PulseRoots",
      "description": "Todas las páginas y géneros de PulseRoots, agrupados por familia.",
      "isPartOf": { "@id": `${SITE}/#website` },
      "inLanguage": "es",
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": families.length,
        "itemListElement": families.map((family, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": family.name,
          "url": `${SITE}/genres/${family.slug}/`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${SITE}/es/` },
        { "@type": "ListItem", "position": 2, "name": "Mapa del Sitio", "item": canonical },
      ],
    },
  ],
});
---

<BaseLayout
  title="Mapa del Sitio - PulseRoots"
  description="Mapa del sitio de PulseRoots - una visualización interactiva de géneros de música electrónica. Explora todas las páginas de géneros disponibles."
  canonical={canonical}
  lang="es"
  jsonLd={jsonLd}
>
  <header>
    <div id="header-container">
      <a href="/pulse.roots/es/" id="logo-link" aria-label="PulseRoots - Mapa del Sitio - Inicio">
        <h1>PulseRoots - Mapa del Sitio</h1>
      </a>
    </div>
  </header>
  <main>
    <div id="main-container" class="sitemap-page">
      <p class="sitemap-lead">
        Explora los {totalStyles} estilos de música electrónica de PulseRoots, agrupados por familia, o abre la
        <a href="/pulse.roots/genres/">vista general de familias</a>.
      </p>

      <h2>Todas las Páginas</h2>
      <ul>
        <li><a href="/pulse.roots/es/">Inicio</a></li>
        <li><a href="/pulse.roots/genres/">Géneros</a></li>
        <li><a href="/pulse.roots/es/contact/">Contacto</a></li>
        <li><a href="/pulse.roots/es/about/">Sobre PulseRoots</a></li>
        <li><a href="/pulse.roots/es/privacy/">Política de Privacidad</a></li>
      </ul>

      <h2>Todos los Géneros</h2>
      {families.map(family => (
        <section class="sitemap-family">
          <h3><a href={`/pulse.roots/genres/${family.slug}/`}>{family.name}</a></h3>
          <ul>
            {family.styles.map(style => (
              <li><a href={`/pulse.roots/genres/${style.fullSlugPath}/`}>{style.genreName}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <footer>
    <div class="footer-bottom">
      <p>&copy; 2026 PulseRoots. Mapeando el pulso de la música electrónica.</p>
    </div>
  </footer>

  <style>
    .sitemap-page { padding: 20px; max-width: 800px; margin: 0 auto; color: var(--text-main); }
    .sitemap-lead { color: var(--text-muted); line-height: 1.7; }
    .sitemap-page a { color: var(--accent-pink); text-decoration: none; }
    .sitemap-page a:hover { text-decoration: underline; }
    .sitemap-page h2 { margin-top: 32px; }
    .sitemap-family { margin-top: 22px; }
    .sitemap-family h3 { font-size: 1.1rem; margin: 0 0 6px; }
    .sitemap-family ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .sitemap-family li { font-size: 0.92rem; }
  </style>
</BaseLayout>
