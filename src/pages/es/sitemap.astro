---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { loadGenres, flattenGenres, slugify } from '../../utils/genres-data.js';

const SITE = 'https://mendiak.github.io/pulse.roots';
const canonical = `${SITE}/es/sitemap/`;

const families = loadGenres('es')
  .map(family => {
    const name = family.style || family.name;
    if (!name) return null;
    const familySlug = slugify(name);
    return {
      name,
      slug: familySlug,
      styles: flattenGenres(family.substyles || [], 'es').map(style => ({
        ...style,
        fullSlugPath: `${familySlug}/${style.fullSlugPath}`,
      })),
    };
  })
  .filter(Boolean)
  .sort((a, b) => a.name.localeCompare(b.name, 'es'));

const totalStyles = families.reduce((sum, family) => sum + family.styles.length + 1, 0);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "url": canonical,
      "name": "Todos los géneros de música electrónica, de la A a la Z",
      "description": `Todos los géneros de música electrónica de PulseRoots: ${totalStyles} estilos y subestilos repartidos en ${families.length} familias.`,
      "isPartOf": { "@id": `${SITE}/#website` },
      "inLanguage": "es",
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": families.length,
        "itemListElement": families.map((family, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": family.name,
          "url": `${SITE}/es/genres/${family.slug}/`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${SITE}/es/` },
        { "@type": "ListItem", "position": 2, "name": "Todos los géneros", "item": canonical },
      ],
    },
  ],
});
---

<BaseLayout
  title={`Todos los géneros de música electrónica A-Z | PulseRoots`}
  description={`Todos los géneros de música electrónica de PulseRoots: ${totalStyles} estilos y subestilos en ${families.length} familias, del techno y el house al ambient, el bass o el global club.`}
  canonical={canonical}
  lang="es"
  jsonLd={jsonLd}
  esAvailable
>
  <Header brandAs="div" simple />
  <main>
    <div id="main-container" class="sitemap-page container">
      <h1>Todos los géneros de música electrónica, de la A a la Z</h1>
      <p class="sitemap-lead">
        PulseRoots documenta <strong>{totalStyles} estilos y subestilos de música electrónica</strong> repartidos en
        {' '}<strong>{families.length} familias</strong>. Esta página los lista todos, agrupados por familia y
        en orden alfabético dentro de cada grupo. Si prefieres empezar por las ramas generales, abre la
        <a href="/pulse.roots/es/genres/">vista general de familias</a>; si buscas la historia que hay detrás,
        lee la <a href="/pulse.roots/es/guides/electronic-music-history/">historia de la música electrónica</a>.
      </p>

      <ul class="sitemap-quick">
        <li><a href="/pulse.roots/es/genres/">Explorar por familia</a></li>
        <li><a href="/pulse.roots/es/guides/">Todas las guías</a></li>
        <li><a href="/pulse.roots/es/about/">Sobre PulseRoots</a></li>
        <li><a href="/pulse.roots/es/contact/">Contacto</a></li>
      </ul>

      <h2>Todos los géneros por familia</h2>
      {families.map(family => (
        <section class="sitemap-family">
          <h3><a href={`/pulse.roots/es/genres/${family.slug}/`}>{family.name}</a></h3>
          <ul>
            {family.styles.map(style => (
              <li><a href={`/pulse.roots/es/genres/${style.fullSlugPath}/`}>{style.genreName}</a></li>
            ))}
          </ul>
        </section>
      ))}

      <p class="sitemap-footer-note">
        La taxonomía es una interpretación, no una regla: los géneros se solapan, se dividen y se
        fusionan, y un mismo sonido puede clasificarse de otra forma en otro sitio. Cada página de
        género enlaza con su estilo padre, sus subestilos y los estilos que comparten artistas clave.
      </p>
    </div>
  </main>
  <Footer />

  <style>
    /* #main-container is a row flexbox for the home tree; this page needs a
       normal stacked document, so the ID selector raises specificity over it. */
    #main-container.sitemap-page {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-width: 1000px;
      margin: 32px auto 48px;
      padding: 32px;
      color: var(--text-main);
    }
    .sitemap-page h1 { font-size: clamp(1.8rem, 3.6vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 16px; }
    .sitemap-page h2 { margin: 36px 0 8px; font-size: 1.3rem; }
    .sitemap-lead { color: var(--text-muted); line-height: 1.75; max-width: 760px; }
    .sitemap-lead strong { color: var(--text-main); }
    .sitemap-page a { color: var(--accent-pink); text-decoration: none; overflow-wrap: anywhere; }
    .sitemap-page a:hover { text-decoration: underline; }
    .sitemap-quick { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 20px 0 0; padding: 0; font-size: 0.9rem; }
    .sitemap-family { margin-top: 22px; }
    .sitemap-family h3 { font-size: 1.05rem; margin: 0 0 6px; }
    .sitemap-family ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 4px 16px; }
    .sitemap-family li { font-size: 0.9rem; }
    .sitemap-footer-note { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--glass-border); color: var(--text-muted); line-height: 1.7; font-size: 0.92rem; }
    @media (max-width: 768px) {
      #main-container.sitemap-page { margin: 20px; padding: 22px; }
    }
    @media (max-width: 420px) {
      #main-container.sitemap-page { margin: 12px; padding: 16px; }
      .sitemap-family ul { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 4px 12px; }
    }
  </style>
</BaseLayout>
