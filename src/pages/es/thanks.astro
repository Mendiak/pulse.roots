---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const canonical = 'https://mendiak.github.io/pulse.roots/es/thanks/';
---

<BaseLayout
  title="Gracias - PulseRoots"
  description="Gracias por contactar a PulseRoots. Tu mensaje ha sido enviado con éxito."
  canonical={canonical}
  lang="es"
  noindex
>
  <Header simple brandAs="div" />
  <div id="main-container" class="container">
    <h1><i class="bi bi-check-circle-fill" aria-hidden="true"></i> ¡Mensaje Enviado!</h1>
    <p>Gracias por escribirme. Revisaré tu mensaje y te responderé lo antes posible.</p>
    <a href="/pulse.roots/es/" class="back-button">Volver a PulseRoots</a>
  </div>

  <Footer />

  <script is:inline>
    // Señal fiable de conversión: el formulario hace POST a Web3Forms y
    // redirige aquí, así que GA4 nunca llega a enviar form_submit.
    // La marca se pone al enviar: evita contar visitas directas o recargas,
    // y se borra después de disparar para no duplicar el lead.
    (function () {
      var submitted = false;
      try { submitted = sessionStorage.getItem('pulseRootsContactSubmitted') === '1'; } catch (e) {}
      if (!submitted) return;

      window.addEventListener('load', function () {
        if (typeof window.gtag === 'function' && window._gaLoaded) {
          window.gtag('event', 'generate_lead', {
            method: 'contact_form',
            form_name: 'contact',
            language: 'es'
          });
          try { sessionStorage.removeItem('pulseRootsContactSubmitted'); } catch (e) {}
        }
      });
    })();
  </script>

  <style>
    #main-container { flex-direction: column; margin: 40px auto; width: 100%; max-width: 600px; }
    .container { padding: 40px; text-align: center; }
    h1 {
      color: var(--text-main);
      margin-top: 0;
      font-size: 1.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    h1 i {
      color: var(--accent-cyan);
    }
    p {
      color: var(--text-muted);
      max-width: 450px;
      margin-left: auto;
      margin-right: auto;
    }
  </style>
</BaseLayout>
