---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { loadGenres, flattenGenres } from '../../utils/genres-data.js';

const SITE = 'https://mendiak.github.io/pulse.roots';

const currentLang = Astro.currentLocale || 'en';
const genres = loadGenres(currentLang);

export async function getStaticPaths() {
  const genres = loadGenres('en');
  const allGenres = flattenGenres(genres, 'en');

  // Some styles live in more than one branch of the tree (e.g. Acid House under
  // Chicago House and under Acid Techno). Detect them so the heading and title
  // can carry the parent name instead of publishing duplicate metadata.
  // Comparison is case-insensitive because the dataset is inconsistent
  // ("Acid Breaks" vs "Acid breaks").
  const byName = new Map();
  for (const g of allGenres) {
    const key = g.genreName.trim().toLowerCase();
    if (!byName.has(key)) byName.set(key, []);
    byName.get(key).push(g);
  }

  return allGenres.map(g => {
    const parent = g.breadcrumbs[g.breadcrumbs.length - 1] || null;
    const sameName = byName.get(g.genreName.trim().toLowerCase()) || [];
    const isAmbiguous = sameName.length > 1;
    const alternate = isAmbiguous
      ? sameName.find(o => o.fullSlugPath !== g.fullSlugPath) || null
      : null;

    return {
      params: { slug: g.fullSlugPath },
      props: {
        genreName: g.genreName,
        fullSlugPath: g.fullSlugPath,
        description: g.description,
        wikipediaUrl: g.wikipediaUrl,
        spotifyTrackId: g.spotifyTrackId,
        exampleTrack: g.exampleTrack,
        keyArtists: g.keyArtists,
        children: g.children,
        breadcrumbs: g.breadcrumbs,
        isAmbiguous,
        contextLabel: parent ? parent.name : '',
        alternate: alternate
          ? {
              path: alternate.fullSlugPath,
              contextLabel: alternate.breadcrumbs.length
                ? alternate.breadcrumbs[alternate.breadcrumbs.length - 1].name
                : '',
            }
          : null,
      },
    };
  });
}

const {
  genreName,
  fullSlugPath,
  description,
  breadcrumbs,
  wikipediaUrl,
  spotifyTrackId,
  exampleTrack,
  keyArtists = [],
  children = [],
  isAmbiguous = false,
  contextLabel = '',
  alternate = null,
} = Astro.props;

const parent = breadcrumbs[breadcrumbs.length - 1] || null;
const displayName = isAmbiguous && contextLabel ? `${genreName} (${contextLabel})` : genreName;

const canonical = `${SITE}/genres/${fullSlugPath}/`;
const metaDesc = description
  ? description.substring(0, 155).replace(/\s+\S*$/, '')
  : `Explore ${genreName} in electronic music on PulseRoots.`;

// Keyword-first title, trimmed to stay inside the ~60 character SERP limit.
const longTitle = `${displayName}: Subgenres, Artists & Tracks | PulseRoots`;
const title = longTitle.length <= 60 ? longTitle : `${displayName} | PulseRoots`;

const breadcrumbEntries = [
  { name: 'Home', url: `${SITE}/` },
  ...breadcrumbs.map(crumb => ({
    name: crumb.name,
    url: `${SITE}/genres/${crumb.slug}/`,
  })),
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        ...breadcrumbEntries.map((entry, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": entry.name,
          "item": entry.url,
        })),
        {
          "@type": "ListItem",
          "position": breadcrumbEntries.length + 1,
          "name": displayName,
          "item": canonical,
        },
      ],
    },
    {
      "@type": "MusicGenre",
      "name": displayName,
      "description": description || metaDesc,
      "url": canonical,
      ...(wikipediaUrl ? { "sameAs": [wikipediaUrl] } : {}),
    },
  ],
});

function buildBreadcrumbHtml() {
  let html = '<nav id="breadcrumbs" aria-label="Breadcrumb">';
  html += `<a href="/pulse.roots/">Home</a>`;
  for (const crumb of breadcrumbs) {
    html += ` <span class="breadcrumb-sep">›</span> <a href="/pulse.roots/genres/${crumb.slug}/">${crumb.name}</a>`;
  }
  html += ` <span class="breadcrumb-sep">›</span> <span class="breadcrumb-current">${displayName}</span>`;
  html += '</nav>';
  return html;
}

const genreScript = `window.PR_LANG='${currentLang}';window.PR_I18N={};window.PR_I18N_FALLBACK={};window.PR_GENRE_TO_LOAD=${JSON.stringify(genreName)};`;
---

<BaseLayout
  title={title}
  description={metaDesc}
  canonical={canonical}
  ogTitle={title}
  ogDescription={metaDesc}
  jsonLd={jsonLd}
>
  <div id="scroll-progress-container">
    <div id="scroll-progress-bar"></div>
  </div>

  <Header brandAs="div" />

  <div id="history-banner">
    <p><strong>Music History:</strong> <span id="history-fact"></span></p>
  </div>

  <main>
    <div id="main-container">
      <div id="tooltip" class="info-box" aria-label="Breadcrumb">
        <section>
          <Fragment set:html={buildBreadcrumbHtml()} />
        </section>
      </div>

      <div id="visualization-container">
        <div id="loading-spinner" class="hidden">
          <div class="spinner"></div>
          <p>Loading genres...</p>
        </div>
        <svg id="treemap"></svg>
      </div>

      <div id="mobile-nav-container">
        <h2>Explore Genres</h2>
        <div id="mobile-search-container">
          <input type="text" id="mobile-search-input" placeholder="Filter genres..." autocomplete="off" aria-label="Filter genres">
          <button id="mobile-clear-button" class="hidden"><i class="bi bi-x-lg"></i></button>
        </div>
        <div id="accordion-controls">
          <button id="expand-all-btn">Expand All</button>
          <button id="collapse-all-btn">Collapse All</button>
        </div>
        <ul id="mobile-genre-list"></ul>
      </div>
    </div>

    <section id="genre-details" class="container" aria-labelledby="genre-heading">
      <h1 id="genre-heading" class="genre-heading">{displayName}</h1>

      {parent && (
        <p class="genre-parent">
          Part of <a href={`/pulse.roots/genres/${parent.slug}/`}>{parent.name}</a>
        </p>
      )}

      {description && <p class="genre-description">{description}</p>}

      {keyArtists.length > 0 && (
        <section class="genre-block">
          <h2>Key artists</h2>
          <ul class="genre-list">
            {keyArtists.map(artist => (
              <li>
                {artist.url
                  ? <a href={`https://open.spotify.com/artist/${artist.url}`} target="_blank" rel="noopener noreferrer">{artist.name}</a>
                  : <span>{artist.name}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {exampleTrack && (
        <section class="genre-block">
          <h2>Listen to an example</h2>
          <p>
            {spotifyTrackId
              ? <a href={`https://open.spotify.com/track/${spotifyTrackId}`} target="_blank" rel="noopener noreferrer">{exampleTrack}</a>
              : exampleTrack}
          </p>
        </section>
      )}

      {children.length > 0 && (
        <section class="genre-block">
          <h2>Subgenres</h2>
          <ul class="genre-list">
            {children.map(child => (
              <li><a href={`/pulse.roots/genres/${child.fullSlugPath}/`}>{child.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      {wikipediaUrl && (
        <p class="genre-source">
          <a href={wikipediaUrl} target="_blank" rel="noopener noreferrer">
            Read more about {genreName} on Wikipedia
          </a>
        </p>
      )}

      {alternate && (
        <p class="genre-source">
          This page covers {genreName} within {contextLabel || 'this branch'}.
          {alternate.contextLabel
            ? <> See also <a href={`/pulse.roots/genres/${alternate.path}/`}>{genreName} in {alternate.contextLabel}</a>.</>
            : <> See also <a href={`/pulse.roots/genres/${alternate.path}/`}>the other {genreName} page</a>.</>}
        </p>
      )}
    </section>

    <button id="back-to-top-btn" aria-label="Back to Top">
      <i class="bi bi-arrow-up"></i>
    </button>
  </main>

  <div id="modal-overlay"></div>

  <div id="info-panel" role="dialog" aria-modal="true" aria-label="Genre Information" aria-labelledby="info-panel-title">
    <div id="info-content"></div>
    <div id="scroll-indicator" class="hidden">
      <i class="bi bi-arrow-down-circle"></i>
    </div>
  </div>

  <!-- mini-player removed -->

  <Footer />

  <script is:inline set:html={genreScript} />

  <script>
    import '../../js/main.js';
  </script>
</BaseLayout>
