---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ExploreIntro from '../../components/ExploreIntro.astro';
import { loadGenres, flattenGenres } from '../../utils/genres-data.js';
import { genreDatasetLastmod } from '../../utils/dataset-meta.js';

const SITE = 'https://mendiak.github.io/pulse.roots';

const currentLang = Astro.currentLocale || 'en';
const genres = loadGenres(currentLang);
const datasetLastmod = genreDatasetLastmod();

export async function getStaticPaths() {
  const genres = loadGenres('en');
  const allGenres = flattenGenres(genres, 'en');
  const byPath = new Map(allGenres.map(g => [g.fullSlugPath, g]));

  // Some styles live in more than one branch of the tree (e.g. Acid House under
  // Chicago House and under Acid Techno). Detect them so the heading and title
  // can carry the parent name instead of publishing duplicate metadata.
  // Comparison is case-insensitive because the dataset is inconsistent
  // ("Acid Breaks" vs "Acid breaks").
  const byName = new Map();
  const byParent = new Map();
  for (const g of allGenres) {
    const key = g.genreName.trim().toLowerCase();
    if (!byName.has(key)) byName.set(key, []);
    byName.get(key).push(g);

    const parentKey = g.fullSlugPath.split('/').slice(0, -1).join('/');
    if (!byParent.has(parentKey)) byParent.set(parentKey, []);
    byParent.get(parentKey).push(g);
  }

  // Artist name -> genre paths. Used to build "styles that share key artists".
  const artistIndex = new Map();
  for (const g of allGenres) {
    for (const artist of g.keyArtists || []) {
      const key = (artist.name || '').trim().toLowerCase();
      if (!key) continue;
      if (!artistIndex.has(key)) artistIndex.set(key, []);
      artistIndex.get(key).push(g.fullSlugPath);
    }
  }

  return allGenres.map(g => {
    const parent = g.breadcrumbs[g.breadcrumbs.length - 1] || null;
    const sameName = byName.get(g.genreName.trim().toLowerCase()) || [];
    const parentKey = g.fullSlugPath.split('/').slice(0, -1).join('/');
    const siblings = (byParent.get(parentKey) || [])
      .filter(s => s.fullSlugPath !== g.fullSlugPath)
      .map(s => ({ name: s.genreName, fullSlugPath: s.fullSlugPath }))
      .slice(0, 12);
    const isAmbiguous = sameName.length > 1;
    const alternate = isAmbiguous
      ? sameName.find(o => o.fullSlugPath !== g.fullSlugPath) || null
      : null;

    // Styles that share key artists with this one, excluding the links already
    // rendered elsewhere on the page (parent, children, siblings).
    const relatedCounts = new Map();
    for (const artist of g.keyArtists || []) {
      const key = (artist.name || '').trim().toLowerCase();
      if (!key) continue;
      for (const path of artistIndex.get(key) || []) {
        if (path === g.fullSlugPath) continue;
        relatedCounts.set(path, (relatedCounts.get(path) || 0) + 1);
      }
    }
    const excluded = new Set([
      g.fullSlugPath,
      parentKey,
      ...g.children.map(child => child.fullSlugPath),
      ...siblings.map(sibling => sibling.fullSlugPath),
    ]);
    const related = [...relatedCounts.entries()]
      .filter(([path]) => !excluded.has(path) && byPath.has(path))
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
      .slice(0, 6)
      .map(([path, shared]) => ({
        name: byPath.get(path).genreName,
        fullSlugPath: path,
        shared,
      }));

    const descendantCount = allGenres.filter(other =>
      other.fullSlugPath.startsWith(`${g.fullSlugPath}/`)
    ).length;

    return {
      params: { slug: g.fullSlugPath },
      props: {
        genreName: g.genreName,
        fullSlugPath: g.fullSlugPath,
        description: g.description,
        wikipediaUrl: g.wikipediaUrl,
        spotifyTrackId: g.spotifyTrackId,
        exampleTrack: g.exampleTrack,
        keyArtists: g.keyArtists,
        children: g.children,
        breadcrumbs: g.breadcrumbs,
        isAmbiguous,
        contextLabel: parent ? parent.name : '',
        siblings,
        related,
        descendantCount,
        alternate: alternate
          ? {
              path: alternate.fullSlugPath,
              contextLabel: alternate.breadcrumbs.length
                ? alternate.breadcrumbs[alternate.breadcrumbs.length - 1].name
                : '',
            }
          : null,
      },
    };
  });
}

const {
  genreName,
  fullSlugPath,
  description,
  breadcrumbs,
  wikipediaUrl,
  spotifyTrackId,
  exampleTrack,
  keyArtists = [],
  children = [],
  isAmbiguous = false,
  contextLabel = '',
  alternate = null,
  siblings = [],
  related = [],
  descendantCount = 0,
} = Astro.props;

const parent = breadcrumbs[breadcrumbs.length - 1] || null;
const displayName = isAmbiguous && contextLabel ? `${genreName} (${contextLabel})` : genreName;
const family = breadcrumbs[0] || null;
const pathNames = [...breadcrumbs.map(crumb => crumb.name), genreName];

const canonical = `${SITE}/genres/${fullSlugPath}/`;
const metaDesc = description
  ? description.substring(0, 155).replace(/\s+\S*$/, '')
  : `Explore ${genreName} in electronic music on PulseRoots.`;

// Keyword-first title, trimmed to stay inside the ~60 character SERP limit.
const longTitle = `${displayName}: Subgenres, Artists & Tracks | PulseRoots`;
const title = longTitle.length <= 60 ? longTitle : `${displayName} | PulseRoots`;

const breadcrumbEntries = [
  { name: 'Home', url: `${SITE}/` },
  ...breadcrumbs.map(crumb => ({
    name: crumb.name,
    url: `${SITE}/genres/${crumb.slug}/`,
  })),
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        ...breadcrumbEntries.map((entry, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": entry.name,
          "item": entry.url,
        })),
        {
          "@type": "ListItem",
          "position": breadcrumbEntries.length + 1,
          "name": displayName,
          "item": canonical,
        },
      ],
    },
    {
      "@type": "MusicGenre",
      "name": displayName,
      "description": description || metaDesc,
      "url": canonical,
      "inLanguage": "en",
      "isPartOf": { "@id": `${SITE}/#website` },
      ...(datasetLastmod ? { "dateModified": new Date(datasetLastmod).toISOString() } : {}),
      ...(wikipediaUrl ? { "sameAs": [wikipediaUrl] } : {}),
    },
    ...(children.length > 0
      ? [{
          "@type": "ItemList",
          "name": `${displayName} subgenres`,
          "numberOfItems": children.length,
          "itemListElement": children.map((child, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "name": child.name,
            "url": `${SITE}/genres/${child.fullSlugPath}/`,
          })),
        }]
      : []),
  ],
});

function buildBreadcrumbHtml() {
  let html = '<nav id="breadcrumbs" aria-label="Breadcrumb">';
  html += `<a href="/pulse.roots/">Home</a>`;
  for (const crumb of breadcrumbs) {
    html += ` <span class="breadcrumb-sep">›</span> <a href="/pulse.roots/genres/${crumb.slug}/">${crumb.name}</a>`;
  }
  html += ` <span class="breadcrumb-sep">›</span> <span class="breadcrumb-current">${displayName}</span>`;
  html += '</nav>';
  return html;
}

const genreScript = `window.PR_LANG='${currentLang}';window.PR_I18N={};window.PR_I18N_FALLBACK={};window.PR_GENRE_TO_LOAD=${JSON.stringify(genreName)};`;
---

<BaseLayout
  title={title}
  description={metaDesc}
  canonical={canonical}
  ogTitle={title}
  ogDescription={metaDesc}
  jsonLd={jsonLd}
>
  <div id="scroll-progress-container">
    <div id="scroll-progress-bar"></div>
  </div>

  <Header brandAs="div" />

  <div id="history-banner">
    <p><strong>Music History:</strong> <span id="history-fact"></span></p>
  </div>

  <main>
    <div id="main-container">
      <div id="tooltip" class="info-box" aria-labelledby="intro-title">
        <Fragment set:html={buildBreadcrumbHtml()} />
        <ExploreIntro />
      </div>

      <div id="visualization-container">
        <div id="loading-spinner" class="hidden">
          <div class="spinner"></div>
          <p>Loading genres...</p>
        </div>
        <svg id="treemap"></svg>
      </div>

      <div id="mobile-nav-container">
        <h2 data-i18n="mobileNav.title">Explore Genres</h2>
        <div id="mobile-search-container">
          <input type="text" id="mobile-search-input" placeholder="Filter genres..." autocomplete="off" aria-label="Filter genres" data-i18n-placeholder="search.mobilePlaceholder" data-i18n-aria-label="search.mobileLabel">
          <button id="mobile-clear-button" class="hidden"><i class="bi bi-x-lg"></i></button>
        </div>
        <div id="accordion-controls">
          <button id="expand-all-btn" data-i18n="mobileNav.expandAll">Expand All</button>
          <button id="collapse-all-btn" data-i18n="mobileNav.collapseAll">Collapse All</button>
        </div>
        <ul id="mobile-genre-list"></ul>
      </div>
    </div>

    <section id="genre-details" class="container" aria-labelledby="genre-heading">
      <h1 id="genre-heading" class="genre-heading">{displayName}</h1>

      {parent && (
        <p class="genre-parent">
          Part of <a href={`/pulse.roots/genres/${parent.slug}/`}>{parent.name}</a>
        </p>
      )}

      {description && <p class="genre-description">{description}</p>}

      <section class="genre-block genre-glance">
        <h2>{displayName} at a glance</h2>
        <dl class="genre-glance-list">
          {family && (
            <>
              <dt>Family</dt>
              <dd><a href={`/pulse.roots/genres/${family.slug}/`}>{family.name}</a></dd>
            </>
          )}
          {parent && (
            <>
              <dt>Parent style</dt>
              <dd><a href={`/pulse.roots/genres/${parent.slug}/`}>{parent.name}</a></dd>
            </>
          )}
          <dt>Subgenres</dt>
          <dd>
            {children.length} direct
            {descendantCount > children.length && <> · {descendantCount} in total</>}
          </dd>
          <dt>Path</dt>
          <dd>{pathNames.join(' › ')}</dd>
        </dl>
      </section>

      {keyArtists.length > 0 && (
        <section class="genre-block">
          <h2>Key artists</h2>
          <ul class="genre-list">
            {keyArtists.map(artist => (
              <li>
                {artist.url
                  ? <a href={`https://open.spotify.com/artist/${artist.url}`} target="_blank" rel="noopener noreferrer">{artist.name}</a>
                  : <span>{artist.name}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {exampleTrack && (
        <section class="genre-block">
          <h2>Listen to an example</h2>
          <p>
            {spotifyTrackId
              ? <a href={`https://open.spotify.com/track/${spotifyTrackId}`} target="_blank" rel="noopener noreferrer">{exampleTrack}</a>
              : exampleTrack}
          </p>
        </section>
      )}

      {children.length > 0 && (
        <section class="genre-block">
          <h2>Subgenres</h2>
          <ul class="genre-list">
            {children.map(child => (
              <li><a href={`/pulse.roots/genres/${child.fullSlugPath}/`}>{child.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      {siblings.length > 0 && (
        <section class="genre-block">
          <h2>Related styles</h2>
          <ul class="genre-list">
            {siblings.map(sibling => (
              <li><a href={`/pulse.roots/genres/${sibling.fullSlugPath}/`}>{sibling.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section class="genre-block">
          <h2>Styles that share key artists</h2>
          <p>These styles have key artists in common with {genreName}.</p>
          <ul class="genre-list">
            {related.map(item => (
              <li><a href={`/pulse.roots/genres/${item.fullSlugPath}/`}>{item.name}</a></li>
            ))}
          </ul>
        </section>
      )}

      {wikipediaUrl && (
        <p class="genre-source">
          <a href={wikipediaUrl} target="_blank" rel="noopener noreferrer">
            Read more about {genreName} on Wikipedia
          </a>
        </p>
      )}

      {alternate && (
        <p class="genre-source">
          This page covers {genreName} within {contextLabel || 'this branch'}.
          {alternate.contextLabel
            ? <> See also <a href={`/pulse.roots/genres/${alternate.path}/`}>{genreName} in {alternate.contextLabel}</a>.</>
            : <> See also <a href={`/pulse.roots/genres/${alternate.path}/`}>the other {genreName} page</a>.</>}
        </p>
      )}
    </section>

    <button id="back-to-top-btn" aria-label="Back to Top">
      <i class="bi bi-arrow-up"></i>
    </button>
  </main>

  <div id="modal-overlay"></div>

  <div id="info-panel" role="dialog" aria-modal="true" aria-label="Genre Information" aria-labelledby="info-panel-title">
    <div id="info-content"></div>
    <div id="scroll-indicator" class="hidden">
      <i class="bi bi-arrow-down-circle"></i>
    </div>
  </div>

  <!-- mini-player removed -->

  <Footer />

  <script is:inline set:html={genreScript} />

  <script>
    import '../../js/main.js';
  </script>
</BaseLayout>
