---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadGenres, flattenGenres, slugify } from '../utils/genres-data.js';

const SITE = 'https://mendiak.github.io/pulse.roots';
const canonical = `${SITE}/sitemap/`;

const families = loadGenres('en')
  .map(family => {
    const name = family.style || family.name;
    if (!name) return null;
    const familySlug = slugify(name);
    return {
      name,
      slug: familySlug,
      styles: flattenGenres(family.substyles || [], 'en').map(style => ({
        ...style,
        fullSlugPath: `${familySlug}/${style.fullSlugPath}`,
      })),
    };
  })
  .filter(Boolean)
  .sort((a, b) => a.name.localeCompare(b.name));

const totalStyles = families.reduce((sum, family) => sum + family.styles.length + 1, 0);

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      "url": canonical,
      "name": "All Electronic Music Genres, A to Z",
      "description": `Every electronic music genre on PulseRoots: ${totalStyles} styles and substyles across ${families.length} families.`,
      "isPartOf": { "@id": `${SITE}/#website` },
      "inLanguage": "en",
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": families.length,
        "itemListElement": families.map((family, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": family.name,
          "url": `${SITE}/genres/${family.slug}/`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
        { "@type": "ListItem", "position": 2, "name": "All genres", "item": canonical },
      ],
    },
  ],
});
---

<BaseLayout
  title={`All Electronic Music Genres A-Z: ${totalStyles} Styles | PulseRoots`}
  description={`Every electronic music genre on PulseRoots: ${totalStyles} styles and substyles across ${families.length} families, from techno and house to ambient, bass music and global club.`}
  canonical={canonical}
  jsonLd={jsonLd}
  esAvailable
>
  <Header brandAs="div" simple />
  <main>
    <div id="main-container" class="sitemap-page">
      <h1>All electronic music genres, A to Z</h1>
      <p class="sitemap-lead">
        PulseRoots documents <strong>{totalStyles} electronic music styles and substyles</strong> across
        {' '}<strong>{families.length} families</strong>. This page lists every one of them, grouped by family
        and alphabetical inside each group. If you would rather start from the broad branches, open the
        <a href="/pulse.roots/genres/">family overview</a>; if you want the story behind them, read the
        <a href="/pulse.roots/guides/electronic-music-history/">history of electronic music</a>.
      </p>

      <ul class="sitemap-quick">
        <li><a href="/pulse.roots/genres/">Browse by family</a></li>
        <li><a href="/pulse.roots/guides/">All guides</a></li>
        <li><a href="/pulse.roots/about/">About PulseRoots</a></li>
        <li><a href="/pulse.roots/contact/">Contact</a></li>
      </ul>

      <h2>All genres by family</h2>
      {families.map(family => (
        <section class="sitemap-family">
          <h3><a href={`/pulse.roots/genres/${family.slug}/`}>{family.name}</a></h3>
          <ul>
            {family.styles.map(style => (
              <li><a href={`/pulse.roots/genres/${style.fullSlugPath}/`}>{style.genreName}</a></li>
            ))}
          </ul>
        </section>
      ))}

      <p class="sitemap-footer-note">
        The taxonomy is an interpretation, not a rule: genres overlap, split and merge, and the same
        sound can be classified differently elsewhere. Every genre page links to its parent style, its
        substyles and the styles that share its key artists.
      </p>
    </div>
  </main>
  <Footer />

  <style>
    .sitemap-page { padding: 32px; max-width: 1000px; margin: 24px auto 40px; color: var(--text-main); }
    .sitemap-page h1 { font-size: clamp(1.8rem, 3.6vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 16px; }
    .sitemap-page h2 { margin: 36px 0 8px; font-size: 1.3rem; }
    .sitemap-lead { color: var(--text-muted); line-height: 1.75; max-width: 760px; }
    .sitemap-lead strong { color: var(--text-main); }
    .sitemap-page a { color: var(--accent-pink); text-decoration: none; }
    .sitemap-page a:hover { text-decoration: underline; }
    .sitemap-quick { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 20px 0 0; padding: 0; font-size: 0.9rem; }
    .sitemap-family { margin-top: 22px; }
    .sitemap-family h3 { font-size: 1.05rem; margin: 0 0 6px; }
    .sitemap-family ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .sitemap-family li { font-size: 0.9rem; }
    .sitemap-footer-note { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--glass-border); color: var(--text-muted); line-height: 1.7; font-size: 0.92rem; }
    @media (max-width: 768px) { .sitemap-page { margin: 20px; padding: 22px; } }
  </style>
</BaseLayout>
