---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const canonical = 'https://mendiak.github.io/pulse.roots/thanks/';
---

<BaseLayout
  title="Thank You - PulseRoots"
  description="Thank you for contacting PulseRoots. Your message has been sent successfully."
  canonical={canonical}
>
  <Header simple />
  <div id="main-container" class="container">
    <h2><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Message Sent!</h2>
    <p>Thanks for reaching out. I'll review your message and get back to you as soon as possible.</p>
    <a href="/pulse.roots/" class="back-button">Back to PulseRoots</a>
  </div>

  <Footer />

  <style>
    #main-container { flex-direction: column; margin: 40px auto; width: 100%; max-width: 600px; }
    .container { padding: 40px; text-align: center; }
    h2 {
      color: var(--text-main);
      margin-top: 0;
      font-size: 1.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    h2 i {
      color: var(--accent-cyan);
    }
    p {
      color: var(--text-muted);
      max-width: 450px;
      margin-left: auto;
      margin-right: auto;
    }
  </style>
</BaseLayout>
